# Annotations are necessary to emit an executable binary that is used by the prost toolchain.
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)

# Both lockfiles are required for reproducible builds and are regenerated with
# `CARGO_BAZEL_REPIN=true`.
crate.from_specs(
    cargo_lockfile = "//bazel:Cargo.lock",
    lockfile = "//bazel:Cargo.Bazel.lock",
)
use_repo(crate, "crates")
