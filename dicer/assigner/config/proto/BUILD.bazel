load("//bazel/rules/rust:rules_rust.bzl", "rust_prost_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_scala//scala_proto:scala_proto.bzl", "scala_proto_library")

proto_library(
    name = "advanced_target_config_proto",
    srcs = ["advanced_target_config.proto"],
    visibility = ["//dicer:internal"],
    deps = [
        "//caching/external/proto:config_scope_specification_proto_library",
        "//dicer/external/proto:target_proto_library",
        "//wrappers/rpc:scalapb_proto",
    ],
)

scala_proto_library(
    name = "advanced_target_config_scala_lib",
    visibility = ["//dicer:internal"],
    deps = [":advanced_target_config_proto"],
)

rust_prost_library(
    name = "advanced_target_config_proto_prost_lib",
    crate_name = "dicer_assigner_config_proto_advanced_target_config_proto",
    proto = ":advanced_target_config_proto",
)

proto_library(
    name = "internal_target_config_proto",
    srcs = ["internal_target_config.proto"],
    visibility = ["//dicer:internal"],
    deps = [
        ":advanced_target_config_proto",
        "//caching/external/proto:config_scope_specification_proto_library",
        "//dicer/external/proto:target_proto_library",
        "//wrappers/rpc:scalapb_proto",
    ],
)

scala_proto_library(
    name = "internal_target_config_scala_lib",
    visibility = ["//dicer:internal"],
    deps = [":internal_target_config_proto"],
)

rust_prost_library(
    name = "internal_target_config_proto_prost_lib",
    crate_name = "dicer_assigner_config_proto_internal_target_config_proto",
    proto = ":internal_target_config_proto",
)

proto_library(
    name = "target_migration_config_proto",
    srcs = ["target_migration_config.proto"],
    visibility = ["//dicer:internal"],
    deps = ["//wrappers/rpc:scalapb_proto"],
)

scala_proto_library(
    name = "target_migration_config_scala_lib",
    visibility = ["//dicer:internal"],
    deps = [":target_migration_config_proto"],
)
