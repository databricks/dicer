load("//bazel/rules/rust:rules_rust.bzl", "rust_buffa_library", "rust_prost_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_scala//scala_proto:scala_proto.bzl", "scala_proto_library")

proto_library(
    name = "test_data_proto",
    srcs = ["test_data.proto"],
    testonly = True,
    visibility = ["//dicer:internal"],
    deps = [
        "//dicer/common/proto:common_proto",
        "//dicer/common/proto:dpage_proto_library",
        "//dicer/friend/proto:friend_proto_library",
        "//wrappers/rpc:scalapb_proto",
    ],
)

java_proto_library(
    name = "test_data_proto_java_lib",
    testonly = True,
    visibility = ["//dicer:internal"],
    deps = [":test_data_proto"],
)

rust_prost_library(
    name = "test_data_proto_prost_lib",
    crate_name = "dicer_common_test_proto_test_data_proto",
    proto = ":test_data_proto",
    testonly = True,
    visibility = ["//dicer:internal"],
)

rust_buffa_library(
    name = "test_data_proto_buffa_lib",
    crate_name = "dicer_common_test_proto_test_data_proto_buffa",
    proto = ":test_data_proto",
    testonly = True,
    text = True,
    visibility = ["//dicer:internal"],
)

scala_proto_library(
    name = "test_data_proto_scala_lib",
    testonly = True,
    visibility = ["//dicer:internal"],
    deps = [":test_data_proto"],
)

