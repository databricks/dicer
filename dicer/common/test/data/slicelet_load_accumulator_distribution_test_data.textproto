      { increment_primary_load: { bytes_key: "xy" value: 8 } },
      { advance_clock: { } },
      { check_attributed_loads: {
        debug_msg: "Initial CDF"
        expected_size: 1
        expected_slice_info: [
          { slice: { }
            top_slice_keys: ["ab", "xy"]
            approximate_primary_load: 16.0
            expected_load_distribution: {
              max_error_fraction: 0.02
              points: [
                { key: "ab" cumulative_load_fraction: 0.5 },
                { key: "xy" cumulative_load_fraction: 1.0 }
              ]
            }
          }
        ]
      } },
      { change_assignment: {
        generation: { incarnation: 2 number: 43 }
        current_squid: "slicelet-0"
        new_assignment: [
          { slice: { } resources: ["slicelet-0", "slicelet-1"]
            generation: { incarnation: 2 number: 43 }
            primary_rate_load_opt: 48.0 }
        ]
      } },
      { check_attributed_loads: {
        debug_msg: "Changing the replica count clears hot keys and the CDF"
        expected_size: 1
        expected_loads: [
          { slice: { }
            primary_rate_load: 24.0
            window_low_inclusive_seconds: 1
            window_high_exclusive_seconds: 1
