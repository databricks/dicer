# proto-file: dicer/common/test/proto/test_data.proto
# proto-message: ShouldServeRequestTargetTestDataP

# Cases where an assignment for local_target should NOT be served to a request for request_target.
should_not_serve_test_cases: [
  {
    description: "Both Kubernetes targets, name mismatch"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name2"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
  },
  {
    description: "Both Kubernetes targets, both name and cluster mismatch"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name2"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype1/kjfna2"
      target_type: KUBERNETES
    }
  },
  {
    description: "Both App targets, name mismatch"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name2"
      target_type: APP
      instance_id: "instance-id1"
    }
  },
  {
    description: "Both App targets, instance ID mismatch"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id2"
    }
  },
  {
    description: "Both App targets, both name and instance ID mismatch"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name2"
      target_type: APP
      instance_id: "instance-id2"
    }
  },
  {
    description: "Type mismatch: Kubernetes vs App and name mismatch"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name2"
      target_type: APP
      instance_id: "instance-id1"
    }
  },
  {
    description: "Kubernetes local target and App request target with matching names"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
  },
  {
    description: "App local target and Kubernetes request target with mismatched names"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name2"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
  }
]

# Cases where an assignment for local_target should be served to a request for request_target.
should_serve_test_cases: [
  {
    description: "Both Kubernetes targets, only cluster mismatch (still served for SMK migration)"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype1/kjfna2"
      target_type: KUBERNETES
    }
  },
  {
    description: "Both Kubernetes targets, exact match"
    local_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
    request_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
  },
  {
    description: "Both App targets, exact match"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
  },
  {
    description: "App local target and Kubernetes request target with matching names"
    local_target: {
      name: "name1"
      target_type: APP
      instance_id: "instance-id1"
    }
    request_target: {
      name: "name1"
      kubernetes_cluster_uri: "kubernetes-cluster:test-env/cloud1/public/region1/clustertype2/01"
      target_type: KUBERNETES
    }
  }
]
