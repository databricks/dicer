load("//bazel/rules/rust:rules_rust.bzl", "rust_prost_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_scala//scala_proto:scala_proto.bzl", "scala_proto_library")

proto_library(
    name = "dpage_proto_library",
    srcs = ["dpage.proto"],
    visibility = ["//dicer:internal"],
    deps = ["//wrappers/rpc:scalapb_proto"],
)

scala_proto_library(
    name = "dpage_proto_scala_lib",
    visibility = ["//dicer:internal"],
    deps = [":dpage_proto_library"],
)

proto_library(
    name = "common_proto",
    srcs = ["common.proto"],
    visibility = ["//dicer:internal"],
    deps = [
        "//caching/util/proto:hyper_log_log_proto",
        "//dicer/friend/proto:friend_proto_library",
        "//wrappers/rpc:scalapb_proto",
    ],
)

scala_proto_library(
    name = "common_proto_scala_lib",
    visibility = [
        "//caching/util:__pkg__",
        "//dicer/client:__pkg__",
        "//dicer:internal",
    ],
    deps = [":common_proto"],
)

rust_prost_library(
    name = "common_proto_prost_lib",
    crate_name = "dicer_common_proto_common_proto",
    proto = ":common_proto",
    visibility = ["//dicer:internal"],
)

rust_prost_library(
    name = "dpage_proto_library_prost_lib",
    crate_name = "dicer_common_proto_dpage_proto_library",
    proto = ":dpage_proto_library",
    visibility = ["//dicer:internal"],
)
