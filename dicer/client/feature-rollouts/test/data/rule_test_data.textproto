# proto-file: dicer/client/feature-rollouts/test/proto/test_data.proto
# proto-message: DicerClientFeatureRolloutRuleTestDataP

# Rule protos that should be accepted by `DicerClientFeatureRolloutRule::from_proto`.
valid_rule_test_cases: [
  {
    description: "All fields set with non-empty force lists and fraction 0.5"
    rule_proto: {
      force_enable_target_names: ["target-a", "target-b"]
      force_disable_target_names: ["target-c"]
      target_instance_enable_fraction: 0.5
    }
  },
  {
    description: "Empty force lists with fraction 0.0 (boundary)"
    rule_proto: { target_instance_enable_fraction: 0.0 }
  },
  {
    description: "Empty force lists with fraction 1.0 (boundary)"
    rule_proto: { target_instance_enable_fraction: 1.0 }
  }
]

# Rule protos that should be rejected by `DicerClientFeatureRolloutRule::from_proto`. Each entry
# pairs the proto with a substring expected to appear in the error message.
invalid_rule_test_cases: [
  {
    description: "targetInstanceEnableFraction is absent"
    rule_proto: {}
    expected_error_substring: "targetInstanceEnableFraction must be set"
  },
  {
    description: "fraction below range (-0.1)"
    rule_proto: { target_instance_enable_fraction: -0.1 }
    expected_error_substring: "targetInstanceEnableFraction must be in [0.0, 1.0]"
  },
  {
    description: "fraction below range (-1)"
    rule_proto: { target_instance_enable_fraction: -1 }
    expected_error_substring: "targetInstanceEnableFraction must be in [0.0, 1.0]"
  },
  {
    description: "fraction above range (1.1)"
    rule_proto: { target_instance_enable_fraction: 1.1 }
    expected_error_substring: "targetInstanceEnableFraction must be in [0.0, 1.0]"
  },
  {
    description: "fraction above range (2.0)"
    rule_proto: { target_instance_enable_fraction: 2.0 }
    expected_error_substring: "targetInstanceEnableFraction must be in [0.0, 1.0]"
  },
  {
    description: "force lists overlap on target-b"
    rule_proto: {
      force_enable_target_names: ["target-a", "target-b"]
      force_disable_target_names: ["target-b", "target-c"]
      target_instance_enable_fraction: 0.5
    }
    expected_error_substring: "forceEnableTargetNames and forceDisableTargetNames must not overlap"
  },
  {
    description: "Invalid name in forceEnableTargetNames"
    rule_proto: {
      force_enable_target_names: ["bad_name.bad"]
      target_instance_enable_fraction: 0.5
    }
    expected_error_substring: "Target name must match regex"
  },
  {
    description: "Invalid name in forceDisableTargetNames"
    rule_proto: {
      force_disable_target_names: ["bad_name.bad"]
      target_instance_enable_fraction: 0.5
    }
    expected_error_substring: "Target name must match regex"
  }
]
