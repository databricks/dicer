load("@rules_scala//scala:scala.bzl", "scala_library", "scala_test")

filegroup(
    name = "feature_rollout_configs",
    srcs = glob(["**/*.textproto"], exclude = ["test/**"]),
    visibility = ["//dicer:internal"],
)

filegroup(
    name = "test_feature_rollout_configs",
    srcs = glob(["test/testdata/**/*.textproto"]),
    testonly = True,
    visibility = ["//dicer:internal"],
)

scala_library(
    name = "dicer_client_feature_rollout_config",
    srcs = [
        "src/DicerClientFeatureRolloutConfig.scala",
        "src/DicerClientFeatureRolloutFlag.scala",
        "src/DicerClientFeatureRolloutFlagImpl.scala",
        "src/DicerClientFeatureRolloutRule.scala",
        "src/DicerClientFeatureRolloutRuleOverride.scala",
        "src/DicerClientFeatureRolloutScope.scala",
