    resources = [":feature_rollout_configs"],
    visibility = ["//dicer:internal"],
    deps = [
        "//caching/util:caching_error_code",
        "//caching/util:caching_error_metrics",
        "//caching/util:deterministic_sampling",
        "//caching/util:where_am_i_helper",
        "//dicer/client/feature-rollouts/proto:dicer_client_feature_rollout_config_scala_lib",
        "//dicer/common:target_helper",
        "//dicer/common:target_name",
        "//dicer/external:target",
        "@com_google_protobuf_protobuf_java",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_guava_guava",
        "@maven//:io_prometheus_simpleclient",
        "@scala_proto_rules_grpc_api",
        "@scala_proto_rules_grpc_netty",
        "@scala_proto_rules_grpc_stub",
        "@scala_proto_rules_scalapb_runtime",
    ],
)

