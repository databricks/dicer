load("@rules_scala//scala:scala.bzl", "scala_library", "scala_test")

filegroup(
    name = "feature_rollout_configs",
    srcs = glob(["**/*.textproto"], exclude = ["test/**"]),
    visibility = ["//dicer:internal"],
)

filegroup(
    name = "test_feature_rollout_configs",
    srcs = [
        "test/testdata/all-disabled-feature.textproto",
        "test/testdata/all-enabled-feature.textproto",
        "test/testdata/force-disable-feature.textproto",
        "test/testdata/force-enable-feature.textproto",
        "test/testdata/half-enabled-feature.textproto",
        "test/testdata/malformed/broken-feature.textproto",
        "test/testdata/region-override-feature.textproto",
    ],
    testonly = True,
)

scala_library(
    name = "dicer_client_feature_rollout_config",
    srcs = [
        "src/DicerClientFeatureRolloutConfig.scala",
        "src/DicerClientFeatureRolloutFlag.scala",
        "src/DicerClientFeatureRolloutFlagImpl.scala",
        "src/DicerClientFeatureRolloutRule.scala",
        "src/DicerClientFeatureRolloutRuleOverride.scala",
        "src/DicerClientFeatureRolloutScope.scala",
    ],
    visibility = ["//dicer:internal"],
    deps = [
        "//caching/util:caching_error_code",
        "//caching/util:caching_error_metrics",
        "//caching/util:deterministic_sampling",
        "//caching/util:where_am_i_helper",
        "//dicer/client/feature-rollouts/proto:dicer_client_feature_rollout_config_scala_lib",
        "//dicer/common:target_helper",
        "//dicer/common:target_name",
        "//dicer/external:target",
        "@com_google_protobuf_protobuf_java",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_guava_guava",
        "@maven//:io_prometheus_simpleclient",
        "@scala_proto_rules_grpc_api",
        "@scala_proto_rules_grpc_netty",
        "@scala_proto_rules_grpc_stub",
        "@scala_proto_rules_scalapb_runtime",
    ],
)

scala_test(
    name = "dicer_client_feature_rollout_config_test",
    srcs = [
        "test/DicerClientFeatureRolloutConfigSuite.scala",
        "test/DicerClientFeatureRolloutRuleOverrideSuite.scala",
        "test/DicerClientFeatureRolloutRuleSuite.scala",
        "test/DicerClientFeatureRolloutScopeSuite.scala",
    ],
    data = ["//dicer/client/feature-rollouts/test/data"],
    timeout = "short",
    deps = [
        ":dicer_client_feature_rollout_config",
        "//caching/util:test_util",
        "//dicer/client/feature-rollouts/proto:dicer_client_feature_rollout_config_scala_lib",
        "//dicer/client/feature-rollouts/test/proto:test_data_proto_scala_lib",
        "//dicer/common:target_name",
        "//wrappers/util:async_test_helpers",
        "//wrappers/util:databricks-test",
        "@com_google_protobuf_protobuf_java",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_guava_guava",
        "@scala_proto_rules_grpc_api",
        "@scala_proto_rules_grpc_netty",
        "@scala_proto_rules_grpc_stub",
        "@scala_proto_rules_scalapb_runtime",
    ],
)

scala_test(
    name = "dicer_client_feature_rollout_flag_test",
