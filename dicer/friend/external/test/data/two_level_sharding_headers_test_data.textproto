# Test data for TwoLevelShardingHeaders, shared by the Scala and Rust suites. See
# dicer/friend/external/test/proto/test_data.proto for the schema.

# Pin the exact serialized header name and value for known raw key bytes so Scala and Rust agree
# byte-for-byte on the wire format.
encode_cases {
  description: "8-byte key serializes to its base64 bytes"
  secondary_slice_key: "\x01\x02\x03\x04\x05\x06\x07\x08"
  expected_header_name: "x-databricks-internal-dicer-secondary-slice-key"
  expected_header_value: "AQIDBAUGBwg="
}
encode_cases {
  description: "4-byte key serializes to its base64 bytes"
  secondary_slice_key: "\x11\x22\x33\x44"
  expected_header_name: "x-databricks-internal-dicer-secondary-slice-key"
  expected_header_value: "ESIzRA=="
}
encode_cases {
  # New SliceKeys are limited to 32 bytes at creation time, but we should still serialize them faithfully.
  description: "33-byte key serializes to its base64 bytes"
  secondary_slice_key: "\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21"
  expected_header_name: "x-databricks-internal-dicer-secondary-slice-key"
  expected_header_value: "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyAh"
}

# Extraction from a header map, covering the present, absent, and malformed cases.
decode_cases {
  description: "Secondary header decodes to the key, ignoring the other headers"
  headers {
    name: "x-databricks-internal-dicer-secondary-slice-key"
    value: "AQIDBAUGBwg="
  }
  headers {
    # Primary slice key header.
    name: "x-databricks-internal-dicer-slice-key"
    value: "AAAA"
  }
  headers {
    # Dicer service name header.
    name: "x-databricks-internal-dicer-svc-name"
    value: "test-service"
  }
  expected_slice_key: "\x01\x02\x03\x04\x05\x06\x07\x08"
}
decode_cases {
  description: "No secondary header present yields no key"
  headers {
    name: "x-databricks-internal-dicer-slice-key"
    value: "AAAA"
  }
  expected_absent: true
}
decode_cases {
  description: "Malformed base64 fails to decode"
  headers {
    name: "x-databricks-internal-dicer-secondary-slice-key"
    value: "not valid base64!!!"
  }
  expected_error_message: "base64"
}

# Round-trip keys through the header without pinning the serialized value, including bytes that
# are not base64-friendly on their own (high bit set, zero bytes).
round_trip_cases {
  description: "8-byte fingerprint-shaped key round-trips through the header"
  secondary_slice_key: "\xde\xad\xbe\xef\x00\xff\x7f\x80"
}
round_trip_cases {
  description: "9-byte key with trailing zero round-trips through the header"
  secondary_slice_key: "\x11\x22\x33\x44\x55\x66\x77\x88\x00"
}
